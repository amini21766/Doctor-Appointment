PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_appointment
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Email (SMTP) ---
# Easiest path: sign in as admin → Announcements → "Delivery settings" and paste
# provider credentials there (stored encrypted in MongoDB, verified instantly).
# The SMTP_* values below are an alternative for file-based configuration.
# With no provider, the app does NOT skip emails: it falls back to a free
# Ethereal test inbox (auto-created, no signup) and stores a preview URL for
# every announcement. Nothing reaches real subscriber inboxes in that mode.
# Set EMAIL_TEST_MODE=off to write .eml files to backend/outbox instead (offline).
# Fill the SMTP_* values below to deliver real email to subscribers.
# Gmail (requires 2FA + App Password): SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASSWORD=your-16-char-app-password
# Resend:   SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_USER=resend     SMTP_PASSWORD=re_xxxxxxxx
# SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey     SMTP_PASSWORD=SG.xxxxxxxx
# Brevo:    SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=your-login SMTP_PASSWORD=your-smtp-key
# After editing, restart the backend and run: npm run email:test -- you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@doctorappointment.test
# EMAIL_TEST_MODE=off
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThis123!
ADMIN_NAME=Super Admin
